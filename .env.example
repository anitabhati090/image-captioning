# Copy this file to .env and edit.
# Default = small BLIP model that runs on CPU.
# For BLIP-2 (needs a GPU with ~8 GB+ VRAM) use: Salesforce/blip2-opt-2.7b
CAPTION_MODEL=Salesforce/blip-image-captioning-base
CLIP_MODEL=openai/clip-vit-base-patch32
# Leave empty for auto (cuda if available, else cpu). Or set: cpu / cuda
DEVICE=
HF_HOME=./.cache/huggingface
